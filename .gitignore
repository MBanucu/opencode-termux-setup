# Test timing history is local to the machine that ran the tests.
test/.timings.db
test/recordings/
android/local.properties
__pycache__/

# Sample apps build to out/; xterm.js is copied into the WebView sample at
# build time so the repository keeps one copy of it.
samples/out/
samples/xterm-a11y/assets/xterm/
# The terminal font is copied into a sample's assets at build time, like xterm.
samples/*/assets/terminal-mono.ttf
.tmp/

# A standalone compile of the terminal module.
terminal/out/
