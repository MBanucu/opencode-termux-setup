<?xml version="1.0" encoding="utf-8"?>
<!--
  Setup companion for opencode on Termux.

  It does not bundle opencode: it explains what will be downloaded, asks for
  consent, and hands a single command to Termux through RUN_COMMAND.  The only
  permission it asks the user for is Termux's own RUN_COMMAND permission; it
  also holds INTERNET so a loopback socket can carry the command's output back
  to the page while it runs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Only for the loopback socket Termux streams a running command's output
         to; nothing leaves the device and no other host is contacted. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Without this, Android 11+ hides Termux from us entirely. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Install and uninstall are pages, not dialogs: the command, the
             choice and the output belong on one screen. Not exported. -->
        <activity
            android:name=".InstallActivity"
            android:exported="false"
            android:label="@string/action_install" />

        <!-- Uninstalling has two very different outcomes, so it is a page of its
             own rather than a dialog. Not exported: only this app opens it. -->
        <activity
            android:name=".UninstallActivity"
            android:exported="false"
            android:label="@string/uninstall_title" />

        <!-- "Check setup" has a page of its own: the terminal that shows what
             Termux answers belongs there, not on the start screen. Not exported. -->
        <activity
            android:name=".CheckActivity"
            android:exported="false"
            android:label="@string/check_title" />

        <!-- A confirmed command gets this page: header, the terminal filling the
             screen, footer with copy and cancel. Not exported. -->
        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustPan" />

        <!-- adb entry point, so every action the UI offers is scriptable:
               adb shell am start -n io.github.mbanucu.opencodesetup/.AdbCommandActivity -e command check
             It is exported because adb needs that; it sends the same Termux
             commands and has no other powers. -->
        <activity
            android:name=".AdbCommandActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />

        <!-- Termux answers the PendingIntent we hand it on this action. -->
        <receiver
            android:name=".RunCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.mbanucu.opencodesetup.RUN_COMMAND_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
